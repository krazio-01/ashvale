{
    "name": "ashvale",
    "version": "0.1.0",
    "private": true,
    "description": "A procedurally generated action-adventure realm built from any public GitHub repository.",
    "scripts": {
        "predev": "tsx tools/assets/TranscoderInstaller.ts",
        "dev": "next dev",
        "predev:perf": "tsx tools/assets/TranscoderInstaller.ts",
        "dev:perf": "NEXT_PUBLIC_ENABLE_PERF=true next dev",
        "prebuild": "tsx tools/assets/TranscoderInstaller.ts",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write src",
        "cook": "tsx tools/assets/AssetCooker.ts",
        "verify:assets": "tsx tools/assets/AssetVerifier.ts",
        "cook:clips": "tsx tools/clips/CombatClipCook.ts",
        "audition": "tsx tools/clips/ClipAudition.ts",
        "postinstall": "tsx tools/assets/TranscoderInstaller.ts"
    },
    "dependencies": {
        "@dimforge/rapier3d-compat": "^0.20.0",
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.6.1",
        "@react-three/postprocessing": "^3.0.4",
        "axios": "^1.19.0",
        "generative-loaders": "^0.1.1",
        "mongoose": "^9.9.1",
        "next": "16.2.12",
        "postprocessing": "^6.39.4",
        "r3f-webgpu-perf": "^0.1.4",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "server-only": "^0.0.1",
        "three": "^0.185.1"
    },
    "devDependencies": {
        "@gltf-transform/core": "^4.5.0",
        "@gltf-transform/extensions": "^4.5.0",
        "@gltf-transform/functions": "^4.5.0",
        "@types/node": "^20.19.43",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/three": "^0.185.1",
        "eslint": "^9",
        "eslint-config-next": "16.2.12",
        "meshoptimizer": "^1.1.1",
        "prettier": "^3.9.6",
        "sass": "^1.102.0",
        "tsx": "^4.23.13",
        "typescript": "^5"
    }
}
